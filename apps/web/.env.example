# Postgres — caches GitHub stats and stores better-auth sessions
DATABASE_URL="postgresql://user:password@localhost:5432/nextmd"

# GitHub API token (classic PAT, no scopes needed for public data).
# Enables the GraphQL stats pipeline (commit counts, language bytes, rank).
# Without it the cards fall back to limited unauthenticated REST data.
GITHUB_TOKEN=""

# better-auth — GitHub OAuth sign-in (create an OAuth app at
# https://github.com/settings/developers, callback:
#   <origin>/api/auth/callback/github)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OpenRouter key for the AI assistant
OPENROUTER_API_KEY=""

# Absolute origin used when serializing stats-card URLs into markdown
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3000"
